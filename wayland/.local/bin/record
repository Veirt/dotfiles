#!/usr/bin/env bash

OUPTUT_FILE="$(date +'%Y-%m-%d-%s_screenrecord.mp4')"
output="$(xdg-user-dir VIDEOS)/screenrecord/$OUPTUT_FILE"

if pgrep wl-screenrec; then
    notify-send "Stopping recording."
    killall -INT wl-screenrec
else
    notify-send "Starting recording…"
    sleep 1
    swaync-client --close-latest

    # check parameter, if it equals to audio then record with audio
    if [ "$1" == "audio" ]; then
        wl-screenrec --audio -f "$output"
        exit 0
    fi

    wl-screenrec -f "$output"
fi
